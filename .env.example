# ── LLM endpoint ────────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5
LLM_API_VERSION=        # Azure only; leave empty for every other provider

# ── Safety ───────────────────────────────────────────────────────────────────
APPROVAL_MODE=always    # always | destructive_only | never
QUARANTINE_DIR=_quarantine
JOURNAL_PATH=.organizer/journal.jsonl

# ── Run configuration ────────────────────────────────────────────────────────
ANALYZER_BATCH_SIZE=10  # documents per ANALYZE batch (1-50); also settable per run
MEMORY_PATH=.organizer/memory.md  # persistent per-directory notes across sessions

# ── Egress / extraction ──────────────────────────────────────────────────────
MAX_SNIPPET_CHARS=4000
ALLOWLIST_DIRS=         # optional: JSON array, e.g. ["C:/Users/me/docs"]
